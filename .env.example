NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payload CMS
# Works with local Postgres, Neon, or future AWS RDS — same variable name.
DATABASE_URI=postgresql://payload:payload@localhost:5432/dxi_cms
PAYLOAD_SECRET=replace-with-long-random-string

# Vercel Blob — required on Vercel for Media/article images.
# Create a Blob store in the Vercel dashboard (Storage → Blob) and link it to
# this project for Production + Preview. Token looks like: vercel_blob_rw_...
# Without it, uploads save to ephemeral disk and break on the public site.
BLOB_READ_WRITE_TOKEN=

# Schema sync (develop/staging):
# - `npm run build` always syncs schema so new tables/fields are added automatically
# - `npm run db:ensure` / `npm run db:push` — same sync, runnable manually
# - PAYLOAD_SKIP_SCHEMA_PUSH=true — turn off auto-sync later for locked production DBs
# - On Vercel, if DB is unreachable during build, schema sync is skipped so deploy can finish
# - PAYLOAD_REQUIRE_SCHEMA_PUSH=true — fail the Vercel build when DB sync cannot run

# Vercel tip: NEXT_PUBLIC_SITE_URL must match the URL you open in the browser
# (https, no trailing slash), e.g. https://your-app.vercel.app
# Mismatch causes "You are not allowed to perform this action" on save.
#
# If /admin hangs or stays blank while the public site loads:
# 1. Confirm DATABASE_URI + PAYLOAD_SECRET are set for that Vercel environment
# 2. Neon: runtime can use the pooled URL; build/schema sync prefers the direct host
# 3. Open Runtime Logs for /admin (frontend can still show fallback content when CMS is down)
#
# If `npm run build` fails with "timeout exceeded when trying to connect":
# - Neon project may be asleep/suspended — open the Neon dashboard to wake it
# - Confirm DATABASE_URI host/password are correct for Production vs Preview
# - Prefer Neon direct connection for builds if pooler keeps timing out
