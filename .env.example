NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payload CMS
# Local: postgresql://payload:payload@localhost:5432/dxi_cms
# Vercel preview: Neon pooled connection string (sslmode=require)
DATABASE_URI=postgresql://payload:payload@localhost:5432/dxi_cms
PAYLOAD_SECRET=replace-with-long-random-string

# Vercel Blob (optional locally). When set, media uploads go to Blob instead of disk.
# Created automatically when you add Blob storage in the Vercel project.
BLOB_READ_WRITE_TOKEN=
